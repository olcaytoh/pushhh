rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Worldwide Global Site Statistics & Visitor Counters
    match /global_stats/{statId} {
      allow read, write: if true;
    }

    // Health check / connection test
    match /test/{docId} {
      allow read: if true;
    }

    // Common Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || 
        (request.auth.token.email != null && request.auth.token.email == userId)
      );
    }

    // User Profile Document and all user-owned subcollections (including /data/classroom)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /data/{dataDoc} {
        allow read, write: if isOwner(userId);
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
