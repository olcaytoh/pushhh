{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information for authenticated teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "updatedAt"]
    },
    "TeacherClassData": {
      "title": "TeacherClassData",
      "description": "Synced student roster, class counters, and statistics for the teacher",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "studentsJson": { "type": "string" },
        "countersJson": { "type": "string" },
        "selectedStudentIdsJson": { "type": "string" },
        "lastSyncedAt": { "type": "string" }
      },
      "required": ["userId", "studentsJson", "countersJson", "lastSyncedAt"]
    },
    "GlobalSiteStats": {
      "title": "GlobalSiteStats",
      "description": "Worldwide website visit counts and activity statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalVisits": { "type": "number" },
        "todayVisits": { "type": "number" },
        "lastVisitDate": { "type": "string" },
        "lastVisitTime": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "totalVisits"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document owned by the user"
    },
    "/users/{userId}/data/classroom": {
      "schema": "TeacherClassData",
      "description": "Teacher classroom statistics and student list data"
    },
    "/global_stats/{statId}": {
      "schema": "GlobalSiteStats",
      "description": "Worldwide site visits and counters"
    }
  }
}
